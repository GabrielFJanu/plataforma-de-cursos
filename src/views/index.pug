extends layouts/layout.pug 

block content
    h3.m-4 Cursos disponíveis

    if courses.length > 0
        each course in courses
            div.card.bg-light.m-4(style="max-width: 640px;")
                div.row.no-gutters
                    div.col-md-6
                        iframe(
                            src=`https://www.youtube.com/embed/${course.youtubeId}`,
                            title= course.title,
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share",
                            referrerpolicy="strict-origin-when-cross-origin"
                        )
                    div.col-md-6
                        div.card-body
                            p.card-text.badge.badge-secondary= course.knowledgeArea
                            h5.card-title= course.title
                            p.card-text= course.description 
                            p.card-text
                                small.text-muted Criado em 
                                small.text-muted= `${new Intl.DateTimeFormat('pt-BR', { dateStyle: 'short', timeStyle: 'short' }).format(new Date(course.createdAt))} `
                                small.text-muted por 
                                if course.creator
                                    small.text-muted= `${course.creator.firstname} ${course.creator.lastname}`
                                else
                                    small.text-muted Criador não encontrado
    else 
        p Nenhum curso disponível no momento.